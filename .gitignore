# Per-user Obsidian state (conflicts on git pull)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/cache

# Quartz build output (regenerated by `make site-build`)
.site/public/
.site/node_modules/
.site/.quartz-cache/
.site/quartz/.quartz-cache/
.site/.gh-pages-tmp/
.site/tsconfig.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Quartz plugin loader cache (auto-created symlinks for local plugins)
.site/.quartz/

# Local tooling session state
.dsh/
